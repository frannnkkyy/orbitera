<Window x:Class="Orbitera.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Orbitera.App.ViewModels"
        Title="Orbitera"
        Width="1380"
        Height="900"
        MinWidth="1050"
        MinHeight="700"
        Background="{StaticResource AppBackgroundBrush}"
        FontSize="12"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="PageHeadingTemplate">
            <StackPanel>
                <TextBlock Text="{Binding SectionLabel}" Style="{StaticResource EyebrowTextStyle}" />
                <TextBlock Margin="0,9,0,0" Text="{Binding Title}" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock MaxWidth="720"
                           Margin="0,8,0,0"
                           Text="{Binding Description}"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeadingTemplate}" />

                <Border Margin="0,26,0,0"
                        Padding="26"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel MaxWidth="560" VerticalAlignment="Center">
                            <Border HorizontalAlignment="Left"
                                    Padding="9,5"
                                    Background="#1B2434"
                                    CornerRadius="12">
                                <TextBlock Text="ESPERANDO TU PRIMER ANÁLISIS"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="9"
                                           FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Margin="0,18,0,0"
                                       Text="Tu almacenamiento, con otra perspectiva."
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,9,0,0"
                                       Text="Cuando haya datos, aquí encontrarás un resumen de tus unidades, el espacio disponible y los cambios recientes. Orbitera todavía no analiza ni modifica archivos."
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap" />
                            <StackPanel Margin="0,17,0,0" Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource VioletBrush}" />
                                <TextBlock Margin="8,-4,0,0"
                                           Text="Los resultados aparecerán aquí después de un análisis."
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Column="1"
                              Width="174"
                              Height="174"
                              Margin="20,0,8,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Ellipse Margin="12"
                                     Stroke="#334567"
                                     StrokeThickness="1"
                                     Opacity="0.8" />
                            <Ellipse Margin="31"
                                     Stroke="#33314D"
                                     StrokeThickness="1"
                                     Opacity="0.8" />
                            <Ellipse Width="70" Height="70">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#465C91" Offset="0" />
                                        <GradientStop Color="#252D48" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="0,0,0,146"
                                     Fill="{StaticResource AccentBrush}" />
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="128,0,0,0"
                                     Fill="{StaticResource VioletBrush}" />
                        </Grid>
                    </Grid>
                </Border>

                <UniformGrid Margin="0,16,0,0" Columns="3">
                    <Border Margin="0,0,8,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Almacenamiento" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Margin="0,11,0,0" Text="—" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0" Text="Se mostrará tras el primer análisis" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Margin="4,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Orbit Score" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Margin="0,11,0,0" Text="—" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0" Text="Una puntuación explicable, cuando haya datos" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Último análisis" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Margin="0,11,0,0" Text="—" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0" Text="Todavía no se ha realizado ninguno" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>
                    <Border Margin="0,0,8,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Cambios recientes" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Margin="0,7,0,0"
                                       Text="El historial se completará después de guardar snapshots."
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" />
                            <Border Height="90"
                                    Margin="0,17,0,0"
                                    Background="#111824"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Sin actividad todavía"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="Tus cambios aparecerán aquí."
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Espacio por categoría" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Margin="0,7,0,0"
                                       Text="Una vista de lo que ocupa espacio, sin estimaciones."
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" />
                            <StackPanel Height="90" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Las categorías aparecerán tras el análisis."
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AtlasViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeadingTemplate}" />
                <Border Margin="0,20,0,0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      Margin="0,0,8,0"
                                      Height="36"
                                      Padding="8,5"
                                      ItemsSource="{Binding Volumes}"
                                      SelectedItem="{Binding SelectedVolume}"
                                      DisplayMemberPath="Name"
                                      IsEnabled="{Binding IsScanning}"
                                      ToolTip="Selecciona una unidad disponible" />
                            <TextBox Grid.Column="1"
                                     Height="36"
                                     Padding="10,8"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}"
                                     ToolTip="Ruta de la unidad o carpeta que deseas analizar" />
                            <Button Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Content="Examinar…"
                                    Command="{Binding BrowseFolderCommand}"
                                    Style="{StaticResource QuietButtonStyle}" />
                            <Button Grid.Column="3"
                                    Margin="8,0,0,0"
                                    MinWidth="104"
                                    Content="Analizar"
                                    Command="{Binding ScanCommand}"
                                    Background="#26385A"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    BorderBrush="#425B88"
                                    Style="{StaticResource QuietButtonStyle}" />
                        </Grid>

                        <DockPanel Margin="0,14,0,0">
                            <Button DockPanel.Dock="Right"
                                    Content="Cancelar"
                                    Command="{Binding CancelScanCommand}"
                                    IsEnabled="{Binding IsScanning}"
                                    Style="{StaticResource QuietButtonStyle}" />
                            <StackPanel>
                                <TextBlock Text="{Binding StatusMessage}"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="11" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding ProgressPath}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Height="3"
                                     Margin="0,11,0,0"
                                     IsIndeterminate="{Binding IsScanning}"
                                     Maximum="100"
                                     Value="{Binding ProgressValue}"
                                     Background="#222A38"
                                     Foreground="{StaticResource AccentBrush}"
                                     BorderThickness="0" />

                        <TextBlock Margin="0,9,0,0"
                                   Text="{Binding ErrorMessage}"
                                   Foreground="#FF929E"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding IsLoadingVolumes, StringFormat=Consultando unidades disponibles…}"
                                   Visibility="{Binding IsLoadingVolumes, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <UniformGrid Margin="0,12,0,0" Columns="3">
                    <Border Margin="0,0,5,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Archivos" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding FilesScanned, StringFormat={}{0:N0}}" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Margin="3,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Directorios" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding DirectoriesScanned, StringFormat={}{0:N0}}" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Margin="5,0,0,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Tamaño total" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding BytesScanned, StringFormat={}{0:N0} bytes}" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <TextBlock Margin="2,8,0,0"
                           Text="{Binding InaccessibleEntries, StringFormat=Elementos inaccesibles: {0}}"
                           Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Margin="2,3,0,0"
                           Text="{Binding SkippedReparsePoints, StringFormat=Puntos de reanálisis omitidos para evitar ciclos: {0}}"
                           Style="{StaticResource CaptionTextStyle}" />

                <DockPanel Margin="0,22,0,11">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="↑ Subir carpeta"
                                Command="{Binding NavigateUpCommand}"
                                IsEnabled="{Binding CanNavigateUp}"
                                Style="{StaticResource QuietButtonStyle}" />
                        <Button Margin="8,0,0,0"
                                Content="Abrir carpeta seleccionada"
                                Command="{Binding OpenSelectedFolderCommand}"
                                Style="{StaticResource QuietButtonStyle}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right"
                               MaxWidth="450"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding CurrentDirectoryLabel}"
                               Style="{StaticResource CaptionTextStyle}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding CurrentDirectoryLabel}" />
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="230" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            MinHeight="350"
                            Margin="0,0,7,0"
                            Background="#0D121B"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Viewbox Stretch="Uniform"
                                     MaxHeight="390"
                                     Margin="8">
                                <ItemsControl Width="1000"
                                              Height="520"
                                              ItemsSource="{Binding TreemapItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AtlasItemViewModel}">
                                            <Button Width="{Binding Width}"
                                                    Height="{Binding Height}"
                                                    Padding="2"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Command="{Binding DataContext.SelectTreemapItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTipService.InitialShowDelay="350">
                                                <Button.ToolTip>
                                                    <StackPanel MaxWidth="330">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,5,0,0" Text="{Binding FullPath}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,4,0,0" Text="{Binding SizeDisplay, StringFormat=Tamaño: {0}}" />
                                                        <TextBlock Margin="0,3,0,0" Text="{Binding CategoryDisplay, StringFormat=Categoría: {0}}" />
                                                    </StackPanel>
                                                </Button.ToolTip>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Margin="1"
                                                                Background="{Binding CategoryBrush}"
                                                                BorderBrush="{Binding SelectionBorderBrush}"
                                                                BorderThickness="{Binding SelectionBorderThickness}"
                                                                CornerRadius="4">
                                                            <Grid ClipToBounds="True">
                                                                <Border Background="#1AFFFFFF" />
                                                                <StackPanel Margin="7"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            Visibility="{Binding ShowLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Margin="0,3,0,0"
                                                                               Text="{Binding SizeDisplay}"
                                                                               Foreground="#D9E1F0"
                                                                               FontSize="9" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasScanResult}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                </ItemsControl>
                            </Viewbox>
                            <Border Background="#0D121B">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasScanResult}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="◇"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="32" />
                                    <TextBlock Margin="0,9,0,0"
                                               Text="{Binding StatusMessage}"
                                               HorizontalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="Selecciona una ubicación y analiza para generar el mapa."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Margin="7,0,0,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Detalles" Style="{StaticResource SectionTitleTextStyle}" />
                            <Border Height="1" Margin="0,13,0,13" Background="{StaticResource BorderBrush}" />
                            <TextBlock Text="{Binding SelectedItem.Name, TargetNullValue=Ningún elemento seleccionado}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding SelectedItem.FullPath}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,15,0,0" Text="Tamaño" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Margin="0,3,0,0" Text="{Binding SelectedItem.SizeDisplay, TargetNullValue=—}" FontSize="12" />
                            <TextBlock Margin="0,12,0,0" Text="Tipo" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Margin="0,3,0,0" Text="{Binding SelectedItem.Type, TargetNullValue=—}" FontSize="12" />
                            <TextBlock Margin="0,12,0,0" Text="Categoría" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Margin="0,3,0,0" Text="{Binding SelectedItem.CategoryDisplay, TargetNullValue=—}" FontSize="12" />
                            <TextBlock Margin="0,12,0,0" Text="Extensión" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Margin="0,3,0,0" Text="{Binding SelectedItem.Extension, TargetNullValue=—}" FontSize="12" />
                            <TextBlock Margin="0,12,0,0" Text="Modificado" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Margin="0,3,0,0" Text="{Binding SelectedItem.ModifiedDisplay, TargetNullValue=—}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>

                <DockPanel Margin="0,21,0,10">
                    <TextBlock Text="Contenido de la carpeta" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding CurrentItems.Count, StringFormat={}{0:N0} elementos}"
                               Style="{StaticResource CaptionTextStyle}" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding CurrentItems}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          MaxHeight="270"
                          Background="{StaticResource SurfaceBrush}"
                          Foreground="{StaticResource PrimaryTextBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          RowBackground="#151C29"
                          AlternatingRowBackground="#181F2D">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="*" />
                        <DataGridTextColumn Header="Tamaño" Binding="{Binding SizeDisplay}" Width="*" />
                        <DataGridTextColumn Header="Categoría" Binding="{Binding CategoryDisplay}" Width="*" />
                        <DataGridTextColumn Header="Extensión" Binding="{Binding Extension}" Width="*" />
                        <DataGridTextColumn Header="Modificado" Binding="{Binding ModifiedDisplay}" Width="1.3*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeadingTemplate}" />
                <Grid Margin="0,24,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Evolución del almacenamiento" Style="{StaticResource SectionTitleTextStyle}" />
                    <Button Grid.Column="1"
                            Content="Comparar snapshots"
                            IsEnabled="False"
                            Style="{StaticResource QuietButtonStyle}" />
                </Grid>
                <Border MinHeight="300"
                        Background="#0D121B"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Canvas Margin="34,30,30,36" IsHitTestVisible="False">
                            <Line X1="0" Y1="0" X2="0" Y2="210" Stroke="#263144" StrokeThickness="1" />
                            <Line X1="0" Y1="210" X2="600" Y2="210" Stroke="#263144" StrokeThickness="1" />
                            <Line X1="0" Y1="52" X2="600" Y2="52" Stroke="#202938" StrokeThickness="1" StrokeDashArray="3,4" />
                            <Line X1="0" Y1="105" X2="600" Y2="105" Stroke="#202938" StrokeThickness="1" StrokeDashArray="3,4" />
                            <Line X1="0" Y1="158" X2="600" Y2="158" Stroke="#202938" StrokeThickness="1" StrokeDashArray="3,4" />
                        </Canvas>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Aún no hay historial"
                                       HorizontalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="Las tendencias se mostrarán al guardar más de un snapshot."
                                       Style="{StaticResource BodyTextStyle}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Carpetas con mayor crecimiento" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="Para calcular cambios se necesitan snapshots comparables."
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,18,0,2"
                                   Text="Todavía no hay datos para comparar."
                                   Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DevInsightsViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeadingTemplate}" />
                <UniformGrid Margin="0,24,0,14" Columns="2">
                    <Border Margin="0,0,7,7" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Proyectos" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Margin="0,7,0,0" Text="Sin detecciones todavía" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="7,0,0,7" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Dependencias" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Margin="0,7,0,0" Text="Sin detecciones todavía" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,7,7,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Cachés" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Margin="0,7,0,0" Text="Sin detecciones todavía" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="7,7,0,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Archivos generados" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Margin="0,7,0,0" Text="Sin detecciones todavía" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Padding="22"
                        Background="#111824"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Espacio potencialmente recuperable"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Margin="0,7,0,0"
                                   Text="No se estima espacio hasta identificar datos reales y explicar cada regla."
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CleanupPlannerViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeadingTemplate}" />
                <Border Margin="0,22,0,16" Padding="16" Background="#171A28" BorderBrush="#34314C" BorderThickness="1" CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,10,0" Fill="{StaticResource VioletBrush}" />
                        <TextBlock Text="Planificación segura"
                                   Foreground="{StaticResource VioletBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="10,0,0,0"
                                   Text="Una simulación no elimina archivos."
                                   Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </Border>
                <Border MinHeight="240" Style="{StaticResource CardBorderStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Sin elementos para planificar"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock MaxWidth="440"
                                   Margin="0,8,0,0"
                                   Text="Cuando haya resultados de análisis, podrás revisar candidatos, su nivel de riesgo y el espacio estimado antes de tomar una decisión."
                                   Style="{StaticResource BodyTextStyle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Margin="0,0,7,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Elementos candidatos" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Margin="0,8,0,0" Text="Pendiente de análisis" Style="{StaticResource BodyTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="7,0,0,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Espacio estimado" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Margin="0,8,0,0" Text="Pendiente de análisis" Style="{StaticResource BodyTextStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FileIntelligenceViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeadingTemplate}" />
                <UniformGrid Margin="0,24,0,14" Columns="3">
                    <Border Margin="0,0,7,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Archivos grandes" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Margin="0,9,0,0" Text="Sin resultados de análisis" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Margin="4,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Archivos antiguos" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Margin="0,9,0,0" Text="Sin resultados de análisis" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Margin="7,0,0,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Duplicados" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Margin="0,9,0,0" Text="Sin resultados de análisis" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border MinHeight="230"
                        Background="#0D121B"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Primero, datos. Después, contexto."
                                   HorizontalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock MaxWidth="420"
                                   Margin="0,8,0,0"
                                   Text="Orbitera todavía no ha examinado este equipo. Los resultados se mostrarán solo después de un análisis, con sus criterios visibles."
                                   Style="{StaticResource BodyTextStyle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeadingTemplate}" />
                <Border Margin="0,24,0,12" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Apariencia" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Margin="0,6,0,0" Text="Tema de Orbitera" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="10,5" Background="#1B2434" CornerRadius="10">
                            <TextBlock Text="Oscuro · Activo"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>
                <Border Margin="0,0,0,12" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Privacidad" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Margin="0,7,0,0"
                                   Text="Esta versión de la interfaz no analiza archivos ni transmite información. Las futuras opciones de análisis se explicarán antes de activarse."
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Acerca de Orbitera" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Margin="0,7,0,0"
                                   Text="See your storage differently."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                        <TextBlock Margin="0,5,0,0" Text="Versión de desarrollo · Windows" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="17,20,17,16" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="5,2,0,28">
                        <Border Width="36" Height="36" CornerRadius="11">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8BB4FF" Offset="0" />
                                    <GradientStop Color="#B39AFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="O"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#0D111A"
                                       FontSize="22"
                                       FontWeight="Bold" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Orbitera" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="See your storage differently."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="9" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="11,0,0,8"
                               Text="WORKSPACE"
                               Style="{StaticResource EyebrowTextStyle}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavigationItemViewModel}">
                            <RadioButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         GroupName="OrbiteraNavigation"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                         CommandParameter="{Binding}"
                                         Style="{StaticResource NavigationRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,12,0">
                                        <Path Data="{Binding Icon}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                               VerticalAlignment="Center"
                                               FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border DockPanel.Dock="Bottom"
                        Margin="0,18,0,0"
                        Padding="13"
                        Background="#121923"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource VioletBrush}" />
                            <TextBlock Margin="8,-4,0,0"
                                       Text="PRIVADO POR DISEÑO"
                                       Style="{StaticResource EyebrowTextStyle}" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0"
                                   Text="Sin análisis ni cambios de archivos en esta versión."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource AppBackgroundBrush}"
                    BorderBrush="#1B2230"
                    BorderThickness="0,0,0,1">
                <DockPanel Margin="30,0,32,0">
                    <TextBlock Text="LOCAL STORAGE INTELLIGENCE"
                               VerticalAlignment="Center"
                               Style="{StaticResource EyebrowTextStyle}" />
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" />
                        <TextBlock Margin="7,0,0,0"
                                   Text="EN TU EQUIPO"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ContentControl Margin="32,29,32,36"
                                Content="{Binding CurrentViewModel}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
